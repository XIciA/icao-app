{
  "expo": {
    "name": "听你五个",
    "slug": "readyoufife",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "readyoufife",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.readyoufife.ios",
      "buildNumber": "3573746",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.readyoufife.app",
      "versionCode": 3573746
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许听你五个使用麦克风录制口语练习；经你同意后，点击 AI评分或开启录音后自动转写时，会将录音发送至腾讯云语音识别。",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许听你五个选择图片并随反馈提交。",
          "cameraPermission": false
        }
      ],
      "./plugins/with-android-release-signing",
      "./plugins/with-ios-release-integrity"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
