{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icao-question-bank",
  "type": "object",
  "required": ["id", "title", "nameEn", "description", "summary", "enabled", "study", "capabilities", "categoryIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "nameEn": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "summary": { "type": "string" },
    "enabled": { "type": "boolean" },
    "study": { "type": "object" },
    "capabilities": { "type": "object" },
    "categoryIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
