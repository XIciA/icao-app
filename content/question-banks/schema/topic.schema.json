{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icao-question-bank-topic",
  "type": "object",
  "required": ["id", "categoryId", "name", "declaredCardCount", "cards"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "categoryId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "declaredCardCount": { "type": "integer", "minimum": 0 },
    "cards": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "taskTitle", "audioText"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["text"] },
              "taskTitle": { "type": "string", "minLength": 1 },
              "audioText": { "type": "string", "minLength": 1 },
              "audioTextZh": { "type": "string" },
              "referenceText": { "type": "string" },
              "referenceTextZh": { "type": "string" },
              "audio": { "type": "string", "minLength": 1 },
              "audioDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
              "choices": { "type": "array", "items": { "type": "string" } },
              "choicesZh": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "correctChoiceIndex": { "type": "integer", "minimum": 0 }
            },
            "not": { "anyOf": [{ "required": ["image"] }, { "required": ["imageAlt"] }] }
          },
          {
            "type": "object",
            "required": ["id", "kind", "taskTitle", "image", "imageAlt"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "image" },
              "taskTitle": { "type": "string", "minLength": 1 },
              "image": { "type": "string", "minLength": 1 },
              "imageAlt": { "type": "string", "minLength": 1 }
            },
            "not": {
              "anyOf": [
                { "required": ["audioText"] },
                { "required": ["audio"] },
                { "required": ["choices"] },
                { "required": ["choicesZh"] },
                { "required": ["referenceText"] },
                { "required": ["referenceTextZh"] }
              ]
            }
          }
        ]
      }
    }
  }
}
