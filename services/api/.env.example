NODE_ENV=development
API_RELEASE_ID=development
HOST=127.0.0.1
PORT=3101
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=replace-with-generated-publishable-key
SUPABASE_SECRET_KEY=replace-with-generated-secret-key
INVITE_AUTH_SECRET=replace-with-a-32-character-random-secret-kept-on-ecs-only
ACCOUNT_IDENTITY_HASH_SECRET=replace-with-a-separate-long-lived-32-character-random-secret-kept-on-ecs-only
ACCOUNT_IDENTITY_HASH_KEY_VERSION=1
# JSON object of previous version -> secret during rotations. Keep old aliases until migration completes.
ACCOUNT_IDENTITY_HASH_PREVIOUS_KEYS={}
# Apple Sign in with Apple server credentials. Real values belong only in the protected ECS environment.
APPLE_SIGN_IN_CLIENT_ID=com.example.app
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id
APPLE_PRIVATE_KEY=replace-with-apple-p8-private-key
# Base64-encoded 32-byte AES key. This is intentionally not a usable key.
APPLE_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
AI_TEXT_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_GRAMMAR_MODEL=deepseek-v4-flash
AI_POLISH_MODEL=deepseek-v4-flash
AI_REVIEW_MAX_CONCURRENCY=50
TENCENT_CLOUD_SECRET_ID=replace-with-tencent-secret-id
TENCENT_CLOUD_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_ASR_ENDPOINT=asr.tencentcloudapi.com
AI_ASR_STAGING_BUCKET=ai-transcription-inputs
AI_ASR_POLL_INTERVAL_MS=2000
AI_ASR_TIMEOUT_MS=55000
AI_ASR_SIGNED_URL_TTL_SECONDS=600
AI_ASR_STALE_AUDIO_TTL_SECONDS=86400

# Native phone-auth SMS. Keep disabled until the Aliyun company account,
# qualification, sign, and template are approved. Never commit real secrets.
SMS_PROVIDER=disabled
SMS_LEGAL_ENTITY_NAME=云启航科（成都）科技有限公司
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=云启航科成都
ALIYUN_SMS_TEMPLATE_CODE=SMS_000000000
ALIYUN_SMS_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
# Generate a fresh Standard Webhooks v1 secret; this placeholder is intentionally invalid.
SUPABASE_SMS_HOOK_SECRET=replace-with-generated-v1-whsec-secret
SMS_SEND_DAILY_LIMIT=200
SMS_SEND_MONTHLY_LIMIT=2000
SMS_PHONE_HOURLY_LIMIT=5
SMS_PHONE_DAILY_LIMIT=10
