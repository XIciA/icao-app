NODE_ENV=development
API_RELEASE_ID=development
HOST=127.0.0.1
PORT=3101
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=replace-with-generated-publishable-key
SUPABASE_SECRET_KEY=replace-with-generated-secret-key
INVITE_AUTH_SECRET=replace-with-a-32-character-random-secret-kept-on-ecs-only
ACCOUNT_IDENTITY_HASH_SECRET=replace-with-a-separate-long-lived-32-character-random-secret-kept-on-ecs-only
# HMAC key for device/session digests; keep separate from the asymmetric signing key.
CONTENT_CREDENTIAL_SIGNING_SECRET=replace-with-a-third-long-lived-32-character-random-secret-kept-on-ecs-only
# Ed25519 PKCS#8 PEM. Use escaped newlines when the deployment environment requires a single line.
CONTENT_CREDENTIAL_SIGNING_PRIVATE_KEY=replace-with-ed25519-pkcs8-private-key
# This versioned secret is independent from the non-rotating account identity owner above.
IDENTITY_BENEFIT_DIGEST_SECRET=replace-with-a-second-long-lived-32-character-random-secret-kept-on-ecs-only
IDENTITY_BENEFIT_DIGEST_KEY_VERSION=1
# JSON object of previous version -> secret during rotations. Keep old aliases until migration completes.
IDENTITY_BENEFIT_DIGEST_PREVIOUS_KEYS={}
# Apple Sign in with Apple server credentials. Real values belong only in the protected ECS environment.
APPLE_SIGN_IN_CLIENT_ID=com.example.app
APPLE_TEAM_ID=replace-with-apple-team-id
APPLE_KEY_ID=replace-with-apple-key-id
APPLE_PRIVATE_KEY=replace-with-apple-p8-private-key
APPLE_IAP_BUNDLE_ID=com.readyoufife.ios
APPLE_IAP_APP_APPLE_ID=replace-with-app-apple-id
APPLE_IAP_ROOT_CERTIFICATES_BASE64=replace-with-comma-separated-der-certificates-in-base64
# Dedicated App Store Connect In-App Purchase key. Never reuse the Sign in with Apple key above.
APPLE_IAP_SERVER_ISSUER_ID=replace-with-in-app-purchase-issuer-uuid
APPLE_IAP_SERVER_KEY_ID=replace-with-in-app-purchase-key-id
APPLE_IAP_SERVER_PRIVATE_KEY=replace-with-in-app-purchase-p8-private-key
# Base64-encoded 32-byte AES key. This is intentionally not a usable key.
APPLE_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# WeChat mobile-app login. The link must be an HTTPS directory ending in / and its host must serve
# /.well-known/apple-app-site-association directly from this API with application/json.
WECHAT_APP_ID=replace-with-wechat-mobile-app-id
WECHAT_APP_SECRET=replace-with-wechat-mobile-app-secret
WECHAT_UNIVERSAL_LINK=https://api.example.com/wechat-auth/
# WeChat Pay APIv3: server-only; leave ALL fields empty to disable payment.
# Login AppSecret cannot substitute for any of these merchant credentials.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
# PEM values in an env-file use literal \n between lines.
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=
# Enable only after Native payment is approved and the merchant is bound to WECHAT_APP_ID.
WECHAT_PAY_NATIVE_ENABLED=0
AI_TEXT_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Production fails closed unless both text capabilities use this runtime ID,
# which maps to the public DeepSeek-V4-Flash-0731 disclosure in @icao/contracts.
AI_GRAMMAR_MODEL=deepseek-v4-flash
AI_POLISH_MODEL=deepseek-v4-flash
AI_REVIEW_MAX_CONCURRENCY=50
TENCENT_CLOUD_SECRET_ID=replace-with-tencent-secret-id
TENCENT_CLOUD_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_ASR_ENDPOINT=asr.tencentcloudapi.com
AI_ASR_STAGING_BUCKET=ai-transcription-inputs
AI_ASR_POLL_INTERVAL_MS=2000
AI_ASR_TIMEOUT_MS=55000
AI_ASR_SIGNED_URL_TTL_SECONDS=600
AI_ASR_STALE_AUDIO_TTL_SECONDS=86400

# Native phone-auth SMS. Keep disabled until the Aliyun company account,
# qualification, sign, and template are approved. Never commit real secrets.
SMS_PROVIDER=disabled
SMS_LEGAL_ENTITY_NAME=云启航科（成都）科技有限公司
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=云启航科成都
ALIYUN_SMS_TEMPLATE_CODE=SMS_000000000
ALIYUN_SMS_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
# Generate a fresh Standard Webhooks v1 secret; this placeholder is intentionally invalid.
SUPABASE_SMS_HOOK_SECRET=replace-with-generated-v1-whsec-secret
SMS_SEND_DAILY_LIMIT=200
SMS_SEND_MONTHLY_LIMIT=2000
SMS_PHONE_HOURLY_LIMIT=5
SMS_PHONE_DAILY_LIMIT=10

# Account-scoped optimization assets for the fixed 16k_en engine.
# TENCENT_ASR_HOTWORD_ID=<32-character-id>
# TENCENT_ASR_CUSTOMIZATION_ID=<32-character-id>
