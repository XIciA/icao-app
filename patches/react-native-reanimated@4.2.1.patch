diff --git a/android/CMakeLists.txt b/android/CMakeLists.txt
index d4731e6c9e5b7cfee8c14dcd7c34639e4d3842d6..d5333c153d71d1f4af96f147f44bba4b5b916cb5 100644
--- a/android/CMakeLists.txt
+++ b/android/CMakeLists.txt
@@ -80,13 +80,21 @@ else()
   set(BUILD_TYPE "release")
 endif()
 
+# Consume the output of the Gradle merge task, not an AGP-version-specific
+# CMake intermediate path. The Gradle task dependency is declared below.
+if(BUILD_TYPE STREQUAL "debug")
+  set(MERGE_TASK "mergeDebugNativeLibs")
+else()
+  set(MERGE_TASK "mergeReleaseNativeLibs")
+endif()
+
 add_library(worklets SHARED IMPORTED)
 
 set_target_properties(
   worklets
   PROPERTIES
     IMPORTED_LOCATION
-    "${REACT_NATIVE_WORKLETS_DIR}/android/build/intermediates/cmake/${BUILD_TYPE}/obj/${ANDROID_ABI}/libworklets.so"
+    "${REACT_NATIVE_WORKLETS_DIR}/android/build/intermediates/merged_native_libs/${BUILD_TYPE}/${MERGE_TASK}/out/lib/${ANDROID_ABI}/libworklets.so"
 )
 
 set_target_properties(reanimated PROPERTIES LINKER_LANGUAGE CXX)
diff --git a/android/build.gradle b/android/build.gradle
index 86bace765ea9aaa87018206132cdd2ca253bdc61..323fe9afcdcc0de997774ceb711beb37393c9353 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -350,7 +350,13 @@ if (project != rootProject) {
     evaluationDependsOn(":react-native-worklets")
 
     afterEvaluate {
-        tasks.getByName("externalNativeBuildDebug").dependsOn(findProject(":react-native-worklets").tasks.getByName("externalNativeBuildDebug"))
-        tasks.getByName("externalNativeBuildRelease").dependsOn(findProject(":react-native-worklets").tasks.getByName("externalNativeBuildRelease"))
+        // Include ABI-specific build tasks, so parallel builds wait for the
+        // merged Worklets library before the linker runs.
+        tasks.matching { it.name.startsWith("buildCMakeDebug") }.configureEach {
+            dependsOn(findProject(":react-native-worklets").tasks.getByName("mergeDebugNativeLibs"))
+        }
+        tasks.matching { it.name.startsWith("buildCMakeRelWithDebInfo") }.configureEach {
+            dependsOn(findProject(":react-native-worklets").tasks.getByName("mergeReleaseNativeLibs"))
+        }
     }
 }
