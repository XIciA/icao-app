[Unit]
Description=Optionally replicate Read You 5 Supabase Storage to an explicit remote target
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
ExecStart=/bin/sh /opt/icao/runtime/source/infra/backup/replicate-storage.sh
