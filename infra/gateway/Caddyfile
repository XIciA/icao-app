{
	admin 127.0.0.1:2019
}

(icao_security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}

api.readyoufife.com {
	import icao_security_headers
	reverse_proxy 127.0.0.1:3101
}

cloud.readyoufife.com {
	import icao_security_headers
	@blocked_auth_start path /auth/v1/otp /auth/v1/otp/ /auth/v1/resend /auth/v1/resend/ /auth/v1/signup /auth/v1/signup/ /auth/v1/verify /auth/v1/verify/
	handle @blocked_auth_start {
		respond 404
	}
	@blocked_auth_user_update {
		path /auth/v1/user /auth/v1/user/
		method PUT PATCH
	}
	handle @blocked_auth_user_update {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:8000 {
			header_up -Sb-Forwarded-For
		}
	}
}

ops.readyoufife.com {
	import icao_security_headers
	header {
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	@ops_health path /health/live /health/ready
	handle @ops_health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:3102
	}

	@ops_admin path /v1/admin/*
	handle @ops_admin {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:3102 {
			header_up -X-Ops-Client-IP
			header_up -X-Ops-Proxy-Secret
			header_up X-Ops-Client-IP {remote_host}
			header_up X-Ops-Proxy-Secret {$OPS_TRUSTED_PROXY_SHARED_SECRET}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:4180
	}
}
