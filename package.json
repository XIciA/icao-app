{
  "name": "icao-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "./scripts/with-android-env.sh expo run:android",
    "android:prebuild": "./scripts/with-android-env.sh expo prebuild --platform android --clean",
    "android:emulator": "./scripts/start-android-emulator.sh",
    "assets:serve": "./scripts/serve-design-assets.sh",
    "content:extract": "node tools/question-bank-content.mjs extract",
    "content:build": "node tools/question-bank-content.mjs build",
    "content:check": "node tools/question-bank-content.mjs check",
    "content:check:full": "node tools/question-bank-content.mjs check --full",
    "content:audio:audit": "node tools/question-bank-audio-mapping-audit.mjs audit",
    "content:audio:apply": "node tools/question-bank-audio-mapping-audit.mjs apply",
    "content:audio:verify": "node tools/question-bank-audio-mapping-audit.mjs verify",
    "content:audio:verify:live": "node tools/question-bank-live-verify.mjs",
    "vocabulary:extract": "node tools/vocabulary-content.mjs extract",
    "vocabulary:check": "node tools/vocabulary-content.mjs check",
    "ai:assets:check": "node tools/ai-assets.mjs check",
    "ai:assets:snapshot": "node tools/ai-assets.mjs snapshot",
    "ios": "expo run:ios",
    "ios:phase2a": "./scripts/start-phase2a-ios.sh",
    "ios:phase2a:build": "ICAO_PHASE2A_BUILD=1 ./scripts/start-phase2a-ios.sh",
    "ios:standalone": "./scripts/build-standalone-ios.sh",
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check:app": "sh -n scripts/start-phase2a-ios.sh && sh -n scripts/build-standalone-ios.sh && pnpm typecheck && pnpm lint && pnpm test",
    "check:contracts": "pnpm --filter @icao/contracts check",
    "check:api": "pnpm --filter @icao/contracts build && pnpm --filter @icao/api check",
    "check": "pnpm content:check && pnpm vocabulary:check && pnpm check:app && pnpm check:contracts && pnpm check:api",
    "api:dev": "pnpm --filter @icao/contracts build && pnpm --filter @icao/api dev",
    "api:migration:apply": "pnpm --filter @icao/api migration:apply",
    "api:migration:generate": "pnpm --filter @icao/api migration:generate",
    "api:migration:check": "pnpm --filter @icao/api migration:check",
    "doctor": "pnpm dlx expo-doctor@latest"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.2",
    "@icao/contracts": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "2.110.2",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.15",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.16",
    "expo-network": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-speech": "~55.0.15",
    "expo-splash-screen": "~55.0.22",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.19",
    "expo-web-browser": "~55.0.17",
    "lucide-react-native": "1.24.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.19",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/services/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "private": true
}
