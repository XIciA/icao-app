{
  "name": "icao-app",
  "main": "index.js",
  "version": "1.0.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0 <25",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "start": "ICAO_APP_VARIANT=development expo start --dev-client",
    "web": "EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=0 expo start --web --clear",
    "web:acceptance": "EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=1 expo start --web --clear",
    "web:editorial:preview": "EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=1 EXPO_PUBLIC_ICAO_EDITORIAL_PREVIEW_URL=http://127.0.0.1:4310 expo start --web --clear",
    "web:acceptance:export": "EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=1 expo export --platform web --clear && node scripts/inject-web-boot-shell.mjs",
    "web:export": "EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=0 expo export --platform web --clear && node scripts/inject-web-boot-shell.mjs",
    "web:deploy:export": "node tools/check-web-freeze.mjs && pnpm check:web:source && EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=0 EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_ASSETS=1 EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_CONTENT=1 expo export --platform web --clear && node scripts/inject-web-boot-shell.mjs && node scripts/materialize-web-content-data.mjs && node scripts/materialize-web-question-bank-assets.mjs && node scripts/check-web-boot-shell.mjs",
    "web:edgeone:export": "node scripts/validate-edgeone-web-env.mjs && EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=0 EXPO_PUBLIC_ICAO_WEB_RUNTIME=edgeone-production EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_ASSETS=0 EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_CONTENT=0 expo export --platform web --clear && node scripts/inject-web-boot-shell.mjs && node scripts/materialize-edgeone-upload-config.mjs && node scripts/check-web-boot-shell.mjs && node scripts/check-edgeone-web-export.mjs",
    "web:serve": "node scripts/serve-web-export.mjs",
    "web:content:sync": "node tools/web-content-sync.mjs",
    "check:web:assets": "node scripts/check-web-question-bank-assets.mjs",
    "check:web:boot-shell": "node scripts/check-web-boot-shell.mjs",
    "check:web:source": "node tools/check-lucide-import-boundary.mjs && node scripts/check-promo-assets.mjs",
    "web:bundle:analyze": "EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=0 EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_ASSETS=1 EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_CONTENT=1 expo export --platform web --source-maps external --output-dir .generated/web-bundle-analysis --clear && node scripts/analyze-web-bundle.mjs .generated/web-bundle-analysis --report .generated/web-bundle-report.json",
    "check:web:bundle": "EXPO_PUBLIC_ICAO_UI_ACCEPTANCE=0 EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_ASSETS=1 EXPO_PUBLIC_ICAO_WEB_SAME_ORIGIN_CONTENT=1 expo export --platform web --source-maps external --output-dir .generated/web-bundle-analysis --clear && node scripts/analyze-web-bundle.mjs .generated/web-bundle-analysis --check --report .generated/web-bundle-report.json",
    "check:web:performance-report": "node scripts/check-web-performance-report.mjs",
    "check:web:content": "node scripts/check-web-content-data.mjs",
    "check:web:network": "node tools/check-web-network-boundary.mjs",
    "check:web": "pnpm check:web:source && pnpm web:export && pnpm check:web:boot-shell && pnpm check:web:assets && pnpm check:web:content && pnpm check:web:network && pnpm check:web:bundle",
    "check:web:edgeone": "pnpm check:web:source && pnpm web:edgeone:export",
    "android": "./scripts/with-android-env.sh expo run:android",
    "android:prebuild": "./scripts/with-android-env.sh expo prebuild --platform android --clean",
    "android:emulator": "./scripts/start-android-emulator.sh",
    "android:standalone": "./scripts/build-standalone-android.sh",
    "assets:serve": "./scripts/serve-design-assets.sh",
    "content:extract": "node tools/question-bank-content.mjs extract",
    "content:build": "node tools/question-bank-content.mjs build",
    "content:check": "node tools/question-bank-content.mjs check && pnpm content:text:check",
    "content:check:full": "node tools/question-bank-content.mjs check --full && pnpm content:text:check",
    "content:check:ci": "node tools/question-bank-content.mjs check-source && pnpm content:text:check",
    "content:text:audit": "node tools/question-bank-text-audit.mjs audit",
    "content:text:apply": "node tools/question-bank-text-audit.mjs apply",
    "content:text:check": "node tools/question-bank-text-audit.mjs check",
    "content:audio:durations": "node tools/question-bank-content.mjs sync-durations",
    "opi-hotspot:build": "node scripts/build-opi-hotspots.mjs",
    "opi-hotspot:check": "node scripts/validate-opi-hotspots.mjs",
    "content:radiotelephony:text-audit": "node tools/radiotelephony-audio-text-context-audit.mjs",
    "content:radiotelephony:text-audit:check": "node tools/radiotelephony-audio-text-context-audit.mjs --check",
    "content:radiotelephony:callsign:apply": "node tools/radiotelephony-callsign-correction.mjs apply",
    "content:radiotelephony:callsign:check": "node tools/radiotelephony-callsign-correction.mjs check",
    "content:radiotelephony:callsign:handoff": "node tools/radiotelephony-callsign-correction.mjs verify-handoff",
    "content:radiotelephony:callsign:self-test": "node tools/radiotelephony-callsign-correction.mjs self-test",
    "editorial:extract": "node tools/editorial-content.mjs extract",
    "editorial:check": "node tools/editorial-content.mjs check",
    "editorial:build": "node tools/editorial-content.mjs build",
    "editorial:preview": "node tools/editorial-content.mjs preview",
    "editorial:publish": "node tools/editorial-content.mjs publish",
    "editorial:verify-live": "node tools/editorial-content.mjs verify-live",
    "vocabulary:extract": "node tools/vocabulary-content.mjs extract",
    "vocabulary:check": "node tools/vocabulary-content.mjs check",
    "word-lookup:extract": "node tools/static-word-lookup.mjs extract",
    "word-lookup:check": "node tools/static-word-lookup.mjs check",
    "word-lookup:dataset:assemble": "node tools/static-word-lookup.mjs assemble-dataset",
    "word-lookup:dataset:partial:check": "node tools/static-word-lookup.mjs check-dataset-partial",
    "word-lookup:dataset:check": "node tools/static-word-lookup.mjs check-dataset",
    "word-lookup:runtime:build": "node tools/static-word-lookup.mjs sync-runtime",
    "ai:assets:check": "node tools/ai-assets.mjs check",
    "ai:assets:snapshot": "node tools/ai-assets.mjs snapshot",
    "ai:asr:candidates": "node tools/asr-hotwords.mjs candidates",
    "ai:asr:assets:check": "node tools/asr-hotwords.mjs check",
    "ai:asr:eval": "pnpm --filter @icao/api asr:optimization",
    "ai:asr:eval:run": "./scripts/run-aviation-asr-evaluation.sh",
    "ai:review:eval": "pnpm --filter @icao/api review:eval",
    "ai:asr:vocabulary:prepare": "./scripts/prepare-aviation-asr-vocabulary.sh",
    "ai:asr:cloud:prepare": "./scripts/prepare-asr-cloud.sh",
    "ios": "./scripts/run-ios-development.sh",
    "ios:phase2a": "./scripts/start-phase2a-ios.sh",
    "ios:phase2a:build": "ICAO_PHASE2A_BUILD=1 ./scripts/start-phase2a-ios.sh",
    "ios:standalone": "./scripts/build-standalone-ios.sh",
    "ios:testflight:archive": "./scripts/archive-ios-testflight.sh",
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test:recording": "jest --runInBand src/features/question-bank/recording/__tests__/recording-engine-test.ts src/features/question-bank/recording/__tests__/expo-recorder-adapter-test.tsx src/features/question-bank/recording/__tests__/expo-recorder-adapter.web-test.tsx src/features/question-bank/recording/__tests__/recording-container-validator-test.ts src/features/question-bank/recording/__tests__/recording-media-probe-test.ts src/features/question-bank/recording/__tests__/recording-repository-test.ts src/features/question-bank/recording/__tests__/recording-repository.web-test.ts src/features/question-bank/recording/__tests__/use-recording-playback-test.tsx src/platform/audio/__tests__/audio-session-orchestrator-test.ts src/features/question-bank/__tests__/speaking-practice-lifecycle-test.tsx src/features/question-bank/__tests__/study-session-test.tsx src/app/__tests__/auth-routing-test.tsx src/app/__tests__/auth-screen-test.tsx src/app/__tests__/question-bank-tab-test.tsx",
    "lint": "expo lint",
    "check:audio": "node tools/check-audio-boundaries.mjs",
    "check:ios:storekit": "node tools/verify-native-storekit.mjs",
    "check:ios:testflight": "bash -n scripts/release-ios-testflight.sh && pnpm check:ios:storekit && node tools/check-ios-testflight.mjs",
    "check:legal": "node tools/verify-native-legal-pages.mjs",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "audio:e2e:ios": "./scripts/run-audio-e2e.sh ios",
    "audio:e2e:android": "./scripts/run-audio-e2e.sh android",
    "check:release": "sh -n scripts/start-phase2a-ios.sh scripts/build-standalone-ios.sh scripts/archive-ios-testflight.sh scripts/build-standalone-android.sh scripts/run-audio-e2e.sh scripts/deploy-api-release.sh scripts/prepare-asr-cloud.sh scripts/release-android.sh scripts/release-ios.sh scripts/release-ios-app-store.sh scripts/release-dual.sh scripts/lib/release-common.sh scripts/lib/ios-release-product.sh scripts/lib/android-signing.sh && bash -n scripts/release-ios-testflight.sh && node tools/check-mainline-release.mjs --self-test && node tools/prepare-release.mjs --materialize && node tools/critical-capability-release-evidence.mjs self-test && node tools/verify-release-config.mjs && pnpm check:ios:testflight && pnpm check:legal",
    "check:ui-acceptance": "node tools/verify-ui-acceptance-config.mjs",
    "check:app": "pnpm check:release && pnpm check:ui-acceptance && pnpm check:audio && pnpm typecheck && pnpm lint && pnpm test",
    "check:contracts": "pnpm --filter @icao/contracts check",
    "check:api": "pnpm --filter @icao/contracts build && pnpm --filter @icao/api check",
    "check": "pnpm content:check && pnpm opi-hotspot:check && pnpm editorial:check && pnpm vocabulary:check && pnpm word-lookup:dataset:check && pnpm ai:asr:assets:check && pnpm check:app && pnpm check:contracts && pnpm check:api",
    "check:ci": "pnpm content:check:ci && pnpm opi-hotspot:check && pnpm editorial:check && pnpm vocabulary:check && pnpm word-lookup:dataset:check && pnpm ai:asr:assets:check && pnpm check:app && pnpm check:contracts && pnpm check:api",
    "api:dev": "pnpm --filter @icao/contracts build && pnpm --filter @icao/api dev",
    "api:migration:apply": "pnpm --filter @icao/api migration:apply",
    "api:migration:plan": "pnpm --filter @icao/api migration:plan",
    "api:migration:generate": "pnpm --filter @icao/api migration:generate",
    "api:migration:check": "pnpm --filter @icao/api migration:check",
    "doctor": "pnpm dlx expo-doctor@latest",
    "release:prepare": "node tools/prepare-release.mjs",
    "release:materialize": "node tools/prepare-release.mjs --materialize",
    "release:critical": "node tools/critical-capability-release-evidence.mjs",
    "release:android": "./scripts/release-android.sh",
    "release:ios": "./scripts/release-ios.sh",
    "release:ios:testflight:prepare": "node tools/app-store-connect-testflight.mjs prepare",
    "release:ios:testflight": "./scripts/release-ios-testflight.sh",
    "release:ios:app-store": "./scripts/release-ios-app-store.sh",
    "release:dual": "./scripts/release-dual.sh"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "0.4.2",
    "@expo-google-fonts/geist-mono": "0.4.2",
    "@icao/contracts": "workspace:*",
    "@react-navigation/material-top-tabs": "7.4.5",
    "@react-navigation/native": "^7.1.33",
    "@supabase/supabase-js": "2.110.2",
    "expo": "~55.0.27",
    "expo-apple-authentication": "~55.0.15",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.16",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.17",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-linking": "~55.0.16",
    "expo-native-wechat": "0.3.1",
    "expo-network": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.15",
    "expo-speech": "~55.0.15",
    "expo-splash-screen": "~55.0.22",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "lucide-react-native": "1.24.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-iap": "16.3.2",
    "react-native-nitro-modules": "0.36.5",
    "react-native-pager-view": "8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-track-player": "4.1.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.10.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~55.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.19",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/services/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "private": true
}
